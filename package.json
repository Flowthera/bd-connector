{
  "name": "@flowthera/bd-connector",
  "version": "0.3.0",
  "description": "Free, open-source payment and SMS system for Bangladesh (bKash, Nagad, SSLCommerz, shurjoPay, aamarPay, BulkSMSBD) for Node.js, Claude and other AI agents.",
  "license": "MIT",
  "author": "Flowthera Infotech <ask@flowthera.com> (https://flowthera.com)",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bd-connector": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "serve": "node dist/index.js serve",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "tsc",
    "prepublishOnly": "npm test",
    "check": "node dist/index.js check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "bkash",
    "sslcommerz",
    "sms",
    "bulksmsbd",
    "bangladesh",
    "payments",
    "ai-agents",
    "nagad",
    "shurjopay",
    "aamarpay",
    "rocket",
    "upay",
    "payment-gateway",
    "webhook"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flowthera/bd-connector.git"
  },
  "homepage": "https://github.com/Flowthera/bd-connector#readme",
  "bugs": {
    "url": "https://github.com/Flowthera/bd-connector/issues"
  }
}
