# Flowthera BD Connector settings. Copy to .env and fill in what you use.
# Every setting is explained in docs/configuration.md.

# ── Mode ─────────────────────────────────────────────────────────────
# "sandbox" (default): test gateways only, SMS are not sent.
# "live": real money and real SMS. Switch only when you are ready.
BD_CONNECTOR_MODE=sandbox

# ── Payment server ───────────────────────────────────────────────────
# Public address of this server (gateways send customers back here). Required for payments.
# Example: https://pay.your-shop.com (no trailing slash needed)
BD_CONNECTOR_PUBLIC_URL=
BD_CONNECTOR_PORT=8080
BD_CONNECTOR_BUSINESS_NAME=My Shop
# Send customers here after paying (gets ?order_id=&status=&amount=&transaction_id=&sig=).
# Leave empty to show the built-in receipt page.
BD_CONNECTOR_RETURN_URL=
# Your system's address for payment results (POST, JSON, signed).
BD_CONNECTOR_WEBHOOK_URL=
# A long random secret used to sign webhooks and the return redirect.
BD_CONNECTOR_WEBHOOK_SECRET=
# Turns on the JSON API (Authorization: Bearer <key>). Leave empty to keep it off.
BD_CONNECTOR_API_KEY=
# Turns on the dashboard at /dashboard. Leave empty to keep it off.
BD_CONNECTOR_DASHBOARD_PASSWORD=
# The public checkout page at /pay: on or off.
BD_CONNECTOR_CHECKOUT_PAGE=on
# Where payment records are saved (default: ~/.bd-connector).
BD_CONNECTOR_DATA_DIR=

# ── SMS (BulkSMSBD, https://bulksmsbd.net) ───────────────────────────
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# Receipt SMS to the customer after a successful payment: on or off.
SMS_NOTIFY_CUSTOMER=on
# Your own numbers for payment alerts, comma separated.
SMS_OWNER_NUMBERS=
# Optional custom texts. Placeholders: {business} {amount} {orderId} {reference}
# {transactionId} {provider} {customerName} {customerPhone} {status}
SMS_TEMPLATE_CUSTOMER_SUCCESS=
SMS_TEMPLATE_OWNER_SUCCESS=
SMS_TEMPLATE_OWNER_FAILED=

# ── bKash (Tokenized Checkout) ───────────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── Nagad ────────────────────────────────────────────────────────────
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=

# ── SSLCommerz (cards, wallets, net banking) ─────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ── shurjoPay (bKash, Nagad, Rocket, Upay, cards) ────────────────────
SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=
SHURJOPAY_PREFIX=

# ── aamarPay (bKash, Nagad, Rocket, Upay, cards) ─────────────────────
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=

# ── Only for the single-gateway Claude tools (not needed with the server) ──
BKASH_CALLBACK_URL=
NAGAD_CALLBACK_URL=
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=
SHURJOPAY_RETURN_URL=
AAMARPAY_SUCCESS_URL=
AAMARPAY_FAIL_URL=
AAMARPAY_CANCEL_URL=

# Request timeout in milliseconds (default 30000).
BD_CONNECTOR_TIMEOUT_MS=
