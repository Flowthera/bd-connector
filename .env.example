# Mode: "sandbox" (default) or "live".
# Sandbox uses the bKash and SSLCommerz test gateways and never sends SMS.
# Live moves real money and sends real SMS. Only switch when you are ready.
BD_CONNECTOR_MODE=sandbox

# bKash Tokenized Checkout (credentials from bKash; sandbox credentials come from bKash's developer portal)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Where bKash sends the customer after they approve or cancel
BKASH_CALLBACK_URL=

# Nagad (merchant ID and Nagad's public key come from Nagad; the private key is your own)
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_CALLBACK_URL=

# SSLCommerz (free sandbox store: https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Where SSLCommerz sends the customer afterwards (fail and cancel default to success)
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=

# BulkSMSBD (https://bulksmsbd.net)
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
