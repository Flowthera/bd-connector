# Mode: "sandbox" (default) or "live". Live mode moves real money.
BD_CONNECTOR_MODE=sandbox

# bKash Tokenized Checkout (merchant credentials from bKash)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# SSLCommerz (store id and password from your SSLCommerz panel)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# SMS gateway
SMS_API_KEY=
SMS_SENDER_ID=
